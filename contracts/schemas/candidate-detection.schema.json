{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crime-hotspot.local/schemas/candidate-detection.schema.json",
  "title": "RestrictedCandidateDetection",
  "description": "A machine-generated candidate safety incident requiring human review. It is not a confirmed crime or forecast.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tenant_id", "detection_id", "source_id", "occurred_at", "received_at", "proposed_category", "event_type", "description", "confidence", "detector_version", "evidence_ref", "review_status", "expires_at"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "tenant_id": {"type": "string", "format": "uuid"},
    "detection_id": {"type": "string", "format": "uuid"},
    "source_id": {"type": "string", "format": "uuid"},
    "asset_id": {"type": "string", "format": "uuid"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "received_at": {"type": "string", "format": "date-time"},
    "proposed_category": {"enum": ["property", "violence", "public_order", "traffic_safety", "other", "unmapped"]},
    "event_type": {"enum": ["property_damage", "vandalism", "forced_entry", "physical_fight", "weapon_assault", "crowd_crush", "crowd_disturbance", "vehicle_collision", "vehicle_pedestrian_collision", "road_obstruction", "structural_collapse", "falling_debris", "fire", "explosion", "medical_emergency", "person_fall", "other_acute_hazard", "legacy_unclassified"]},
    "description": {"type": "string", "minLength": 2, "maxLength": 240, "pattern": "^[^\\r\\n]{1,239}[.!?]$"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "detector_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "evidence_ref": {"type": "string", "pattern": "^secret://", "maxLength": 512},
    "review_status": {"enum": ["awaiting_review", "confirmed", "rejected", "expired"]},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
