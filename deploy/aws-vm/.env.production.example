AWS_REGION=ap-south-1
# Runtime DSN is mounted into APIs/workers; migrator DSN is mounted only into
# the one-shot migration container. Both files must be root-managed mode 0400.
DATABASE_RUNTIME_URL_SECRET_FILE=/opt/crime-platform/secrets/database-runtime-url
DATABASE_MIGRATOR_URL_SECRET_FILE=/opt/crime-platform/secrets/database-migrator-url
REKA_API_KEY_SECRET_FILE=/opt/crime-platform/secrets/reka-api-key
REKA_MODEL=reka-flash-3
REKA_PROVIDER_VERIFIED=false
# Voice dispatch stays deterministic and makes no external call until an
# operator supplies an opted-in Twilio configuration and explicitly switches
# this value to live.
DISPATCH_MODE=mock
DISPATCH_TWILIO_SECRET_FILE=/opt/crime-platform/secrets/twilio-voice.json
DISPATCH_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/crime-dispatch
DISPATCH_QUEUE_DLQ_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/crime-dispatch-dlq
DISPATCH_PUBLIC_BASE_URL=https://api.example.com
DISPATCH_CONTACT_SECRET_PREFIX=crime-prediction/review2/tenants
DISPATCH_WORKER_LEASE_SECONDS=90
DISPATCH_MAX_CASES_PER_TENANT_DAY=20
DISPATCH_RETRY_SECONDS=30
DISPATCH_TEST_CALLS_ENABLED=false
# Two independent deployment gates protect any real provider call. Keep the
# kill switch false in mock mode. For a live opted-in demo, set it true and add
# only SHA-256 hashes of the approved E.164 destination numbers (never numbers).
DISPATCH_EXTERNAL_CALLS_ENABLED=false
DISPATCH_APPROVED_DESTINATION_SHA256=
# Explicit hackathon mode: publishes labelled synthetic Bengaluru H3 forecasts
# through the production Postgres repository when no scheduled window exists.
SYNTHETIC_DEMO_FORECASTS=false
# Enables only the source key compiled into the server-side HLS allowlist.
# Set false as an immediate capture kill switch; arbitrary URLs remain invalid.
PUBLIC_HLS_DEMO_ENABLED=true
VIDEO_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/crime-video-jobs
VIDEO_QUEUE_URL_UPLOAD=https://sqs.ap-south-1.amazonaws.com/123456789012/crime-video-upload
VIDEO_QUEUE_URL_INDEX=https://sqs.ap-south-1.amazonaws.com/123456789012/crime-video-index
VIDEO_QUEUE_URL_ANALYZE=https://sqs.ap-south-1.amazonaws.com/123456789012/crime-video-analyze
VIDEO_QUEUE_URL_DELETE=https://sqs.ap-south-1.amazonaws.com/123456789012/crime-video-delete
VIDEO_QUEUE_DLQ_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/crime-video-jobs-dlq
VIDEO_QUEUE_DLQ_URL_UPLOAD=https://sqs.ap-south-1.amazonaws.com/123456789012/crime-video-upload-dlq
VIDEO_QUEUE_DLQ_URL_INDEX=https://sqs.ap-south-1.amazonaws.com/123456789012/crime-video-index-dlq
VIDEO_QUEUE_DLQ_URL_ANALYZE=https://sqs.ap-south-1.amazonaws.com/123456789012/crime-video-analyze-dlq
VIDEO_QUEUE_DLQ_URL_DELETE=https://sqs.ap-south-1.amazonaws.com/123456789012/crime-video-delete-dlq
VIDEO_MEDIA_BUCKET=crime-video-restricted-example
VIDEO_MEDIA_KMS_KEY_ID=arn:aws:kms:ap-south-1:123456789012:key/replace-me
VIDEO_MEDIA_BUCKET_OWNER=123456789012
VIDEO_MAX_UPLOAD_BYTES=8388608
LOCATION_SECRET_PREFIX=crime-prediction/review2/tenants
CORS_ORIGINS=https://crime.example.com
TRUSTED_HOSTS=crime.example.com
MAX_REQUEST_BYTES=9437184
OIDC_ISSUER=https://identity.example.com/
OIDC_AUDIENCE=crime-prediction-api
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
OIDC_ALGORITHMS=RS256
OIDC_MEMBERSHIPS_CLAIM=tenant_memberships
COGNITO_DOMAIN=https://crime-prediction-review2-example.auth.ap-south-1.amazoncognito.com
COGNITO_CLIENT_ID=replace-me
COGNITO_REDIRECT_URI=https://review.example.com/
COGNITO_LOGOUT_URI=https://review.example.com/
API_WORKERS=2
MODEL_REGISTRY_HOST_PATH=/mnt/crime-model-registry
# The managed ALB reaches the instance ENI. Use 127.0.0.1 instead for an
# SSM-only deployment or a reverse proxy running on this same host.
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8080
