APP_ENVIRONMENT=development
REKA_API_KEY=replace-with-server-side-key
# Container deployments may set REKA_API_KEY_FILE instead of exposing the key
# through the container environment.
# REKA_API_KEY_FILE=/run/secrets/reka_api_key
REKA_CHAT_BASE_URL=https://api.reka.ai/v1
REKA_VISION_BASE_URL=https://vision-agent.api.reka.ai
REKA_MODEL=reka-flash-3
REKA_VIDEO_MODEL=reka-edge-2603
REKA_VIDEO_PROMPT_VERSION=1.2.0
REKA_TIMEOUT_SECONDS=120
RUNTIME_DIR=data/runtime
NEAR_LIVE_CAPTURE_SECONDS=20
REKA_INDEX_POLL_SECONDS=3
REKA_INDEX_MAX_POLLS=20
CORS_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1
MAX_REQUEST_BYTES=536870912
API_RATE_LIMIT_REQUESTS=120
API_RATE_LIMIT_WINDOW_SECONDS=60

# Required when APP_ENVIRONMENT=production. Tenant memberships are read only
# from the signed OIDC token claim named by OIDC_MEMBERSHIPS_CLAIM.
OIDC_ISSUER=https://identity.example.com/
OIDC_AUDIENCE=crime-prediction-api
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
OIDC_ALGORITHMS=RS256
OIDC_MEMBERSHIPS_CLAIM=tenant_memberships
DEMO_OPERATOR_TOKEN=demo-operator-one

# Person 1 production runtime. SQLite/local media are development-only.
DATABASE_URL=postgresql://crime_app:change-me@postgres:5432/crime_prediction
# DATABASE_URL_FILE=/run/secrets/database_url
VIDEO_QUEUE_URL=http://localstack:4566/000000000000/crime-video-jobs
# At scale, configure all four stage queues to avoid cross-stage contention.
# VIDEO_QUEUE_URL_UPLOAD=https://sqs.ap-south-1.amazonaws.com/123456789012/crime-video-upload
# VIDEO_QUEUE_URL_INDEX=https://sqs.ap-south-1.amazonaws.com/123456789012/crime-video-index
# VIDEO_QUEUE_URL_ANALYZE=https://sqs.ap-south-1.amazonaws.com/123456789012/crime-video-analyze
# VIDEO_QUEUE_URL_DELETE=https://sqs.ap-south-1.amazonaws.com/123456789012/crime-video-delete
VIDEO_QUEUE_DLQ_URL=http://localstack:4566/000000000000/crime-video-jobs-dlq
VIDEO_MEDIA_BUCKET=crime-video-restricted
VIDEO_MEDIA_KMS_KEY_ID=alias/crime-video
# Prevents confused-deputy writes to a same-named bucket in another account.
VIDEO_MEDIA_BUCKET_OWNER=123456789012
AWS_REGION=ap-south-1
LOCATION_SECRET_PREFIX=crime-prediction/production/tenants
MODEL_REGISTRY_ROOT=/app/data/models
VIDEO_SEGMENT_SECONDS=30
VIDEO_MAX_PENDING_SEGMENTS=20
VIDEO_WORKER_LEASE_SECONDS=120
